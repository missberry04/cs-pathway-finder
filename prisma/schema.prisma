generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  progress     ProgressItem[]
}

model ProgressItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathwaySlug String
  milestoneId String
  completedAt DateTime @default(now())

  @@unique([userId, pathwaySlug, milestoneId])
  @@index([userId, pathwaySlug])
}
